# Database
DATABASE_URL="postgresql://hospiflow:hospiflow_dev@localhost:5432/hospiflow"
POSTGRES_USER=hospiflow
POSTGRES_PASSWORD=hospiflow_dev
POSTGRES_DB=hospiflow

# Redis
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD=""

# JWT
JWT_SECRET="your-secret-key-change-in-production-make-it-long-and-random"
JWT_REFRESH_SECRET="your-refresh-secret-key-change-in-production"
JWT_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# Application
NODE_ENV="development"
PORT=3001
APP_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"
BACKEND_URL="http://localhost:3001"

# Web (frontend) — must point at the API backend (default port 3001)
NEXT_PUBLIC_API_URL="http://localhost:3001"

# M-Pesa
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_PASSKEY=""
MPESA_SHORTCODE="174379"
MPESA_ENVIRONMENT="sandbox"

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Email
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="noreply@hospiflow.com"

# SMS
SMS_PROVIDER=""
SMS_API_KEY=""
SMS_SENDER_ID=""

# WhatsApp
WHATSAPP_PROVIDER=""
WHATSAPP_API_KEY=""
WHATSAPP_PHONE_NUMBER_ID=""

# AI
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Storage
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE="10485760"

# Rate Limiting
RATE_LIMIT_WINDOW_MS="900000"
RATE_LIMIT_MAX="100"

# Session
SESSION_SECRET="your-session-secret-change-in-production"
SESSION_MAX_AGE="86400000"
