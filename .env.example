# Database
# DATABASE_URL — normal development database (seeded via `npm run db:seed`).
DATABASE_URL="postgresql://hospiflow:hospiflow_dev@localhost:5432/hospiflow"

# DATABASE_TEST_URL — isolated integration-test database.
#
# The integration suite (`npm test`) TRUNCATEs and re-seeds on every run, so it
# must NEVER be pointed at DATABASE_URL. Tests refuse to start when
# DATABASE_TEST_URL is missing or resolves to the development database.
#
# One-time setup (the hospiflow role has no CREATEDB, so a superuser creates it):
#   sudo -u postgres createdb -O hospiflow hospiflow_test
# Then, to create/verify it and apply Prisma migrations to it only:
#   export DATABASE_TEST_URL="postgresql://hospiflow:hospiflow_dev@localhost:5432/hospiflow_test"
#   scripts/setup-test-db.sh
#
# Inside Docker use the service name; on the host use localhost.
DATABASE_TEST_URL="postgresql://hospiflow:hospiflow_dev@localhost:5432/hospiflow_test"
POSTGRES_USER=hospiflow
POSTGRES_PASSWORD=hospiflow_dev
POSTGRES_DB=hospiflow

# Redis — BullMQ queue infrastructure for the worker (@hospiflow/worker).
# When Redis is reachable the worker runs the BullMQ `backups` queue; when it is
# not, the worker falls back to its setInterval scheduler and logs the reason.
# Verify with: scripts/redis-health-check.sh
#
# Host development (apps run locally via npm):
REDIS_URL="redis://localhost:6379"
# Inside Docker Compose (service name is `redis`):
# REDIS_URL="redis://redis:6379"
REDIS_PASSWORD=""

# JWT
JWT_SECRET="your-secret-key-change-in-production-make-it-long-and-random"
JWT_REFRESH_SECRET="your-refresh-secret-key-change-in-production"
JWT_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# Application
NODE_ENV="development"
PORT=3001
APP_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"
BACKEND_URL="http://localhost:3001"
CORS_ORIGIN="http://localhost:3000"
LOG_LEVEL="info"

# Web (frontend) — must point at the API backend (default port 3001)
NEXT_PUBLIC_API_URL="http://localhost:3001"

# Payment provider: MPESA or STRIPE. MOCK is rejected in production.
PAYMENT_PROVIDER="MPESA"

# M-Pesa
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_PASSKEY=""
MPESA_SHORTCODE="174379"
MPESA_CALLBACK_URL="http://localhost:3001/api/payments/webhook/mpesa"
MPESA_ENVIRONMENT="sandbox"
# Shared secret required in the `x-hospiflow-webhook-secret` header of every
# POST /api/payments/webhook/mpesa callback. Safaricom does not sign STK
# callbacks, so without this secret the callback endpoint is unauthenticated.
# When empty the endpoint still accepts callbacks but logs a startup warning.
MPESA_WEBHOOK_SECRET=""

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_ENVIRONMENT="test"

# Email
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="noreply@hospiflow.com"

# SMS
SMS_PROVIDER=""
SMS_API_KEY=""
SMS_SENDER_ID=""

# WhatsApp
WHATSAPP_PROVIDER=""
WHATSAPP_API_KEY=""
WHATSAPP_PHONE_NUMBER_ID=""

# AI
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Storage
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE="10485760"

# Rate Limiting
# Production value. Keep this at 100 for production deployments.
# Local development and automated validation suites (B36, Playwright, vitest)
# generate far more than 100 requests from a single IP, so they must override
# it explicitly rather than weakening the production default. See
# apps/api/src/config/index.ts, which already defaults to 1000 in development.
RATE_LIMIT_WINDOW_MS="900000"
RATE_LIMIT_MAX="100"
# For `npm run dev` / B36 validation, raise this in apps/api/.env:
# RATE_LIMIT_MAX="1000"

# Authentication brute-force limiter (applies to /api/auth/login).
# 10 attempts per IP per 15-minute window. The automated suites log in many
# times from 127.0.0.1, so vitest.workspace.ts raises this explicitly for the
# test environment instead of the limiter being disabled in code.
AUTH_RATE_LIMIT_WINDOW_MS="900000"
AUTH_RATE_LIMIT_MAX="10"

# Session
SESSION_SECRET="your-session-secret-change-in-production"
SESSION_MAX_AGE="86400000"

# Backup
BACKUP_DIR="./backups"
BACKUP_RETENTION_DAYS="7"
BACKUP_SCHEDULE="0 2 * * *"
